{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EpcAppReadWriteNoDelete",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": ["arn:aws:s3:::epc-files/*"]
    },
    {
      "Sid": "EpcAppListBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::epc-files"]
    }
  ]
}
