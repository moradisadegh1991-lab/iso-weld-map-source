#!/usr/bin/env bash
# The one command for running the EPC platform on its server.
# Installed to /usr/local/bin/epc by deploy/vps/install.sh. Run it as root.
#
# PGlite is one process: while the service runs, nothing else may open the
# database. So every command that touches it stops the service first and
# starts it again afterwards — even when the command fails.
set -euo pipefail
APP_DIR=/opt/epc/app
ENV_FILE=/etc/epc/epc.env
TOKEN_FILE=/etc/epc/github-token
REPO_URL=https://github.com/moradisadegh1991-lab/iso-weld-map-source.git

[ "$(id -u)" = 0 ] || { echo "با root اجرا کنید: sudo epc $*" >&2; exit 1; }

# Run a command in the app directory as user epc, with the server's settings.
# Without them a command would run against the defaults — a migration into an
# empty .pglite in the app folder instead of the server's database — so a
# settings file user epc cannot read stops it here.
run() {
  runuser -u epc -- test -r "$ENV_FILE" || {
    echo "[ !! ] کاربر epc فایل تنظیمات $ENV_FILE را نمی‌تواند بخواند؛ هیچ کاری انجام نشد." >&2
    echo "       درست کردن: chown root:epc /etc/epc /etc/epc/epc.env && chmod 750 /etc/epc && chmod 640 /etc/epc/epc.env" >&2
    exit 1; }
  runuser -u epc -- bash -c 'set -a; . "$0" || exit 1; set +a; cd "$1"; shift; exec "$@"' "$ENV_FILE" "$APP_DIR" "$@"
}
wait_up() {
  for _ in $(seq 1 60); do
    curl -fs -o /dev/null --max-time 5 http://127.0.0.1:3000/ && return 0
    sleep 2
  done
  return 1
}
# Stop the service for the length of the given command, then bring it back.
offline() {
  local was=no; systemctl is-active --quiet epc && was=yes
  [ $was = yes ] && systemctl stop epc
  local rc=0; "$@" || rc=$?
  if [ "$was" = yes ]; then
    if ! systemctl start epc || ! wait_up; then
      echo "[ !! ] سرویس دوباره بالا نیامد: journalctl -u epc -n 80" >&2
      [ "$rc" -ne 0 ] && return "$rc"
      return 1
    fi
  fi
  return "$rc"
}
build() {
  local reg=(); [ -n "${NPM_REGISTRY:-}" ] && reg=(--registry "$NPM_REGISTRY")
  run npm ci --no-audit --no-fund --loglevel=error "${reg[@]}"
  run npm run build
}
# git as user epc; the token travels in the environment, never in argv or .git/config.
git_epc() {
  local token=""
  if [ ! -s "$TOKEN_FILE" ]; then
    echo "[ !! ] توکن GitHub ثبت نشده است. ابتدا sudo epc save-token را اجرا کنید." >&2
    return 1
  fi
  token=$(tr -d '\r\n' < "$TOKEN_FILE")
  [ -n "$token" ] || { echo "[ !! ] توکن GitHub خالی است." >&2; return 1; }
  local auth; auth=$(printf 'x-access-token:%s' "$token" | base64 -w0)
  runuser -u epc -- env GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never \
    GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=http.https://github.com/.extraheader \
    GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $auth" \
    GIT_CONFIG_KEY_1=credential.helper GIT_CONFIG_VALUE_1= \
    git -C "$APP_DIR" "$@"
}
# The system packages the checkout lists (deploy/vps/packages.txt) that are
# not installed yet, and this helper itself from the checkout: an update that
# brings a feature needing a new package (the no-model reader needed
# tesseract, poppler and OpenCV) or a new epc command takes effect with it.
deps() {
  local list="$APP_DIR/deploy/vps/packages.txt"
  [ -f "$list" ] || { echo "[ !! ] $list نیست — اول sudo epc update" >&2; return 1; }
  local need=() p
  for p in $(grep -v '^#' "$list" | xargs); do dpkg -s "$p" >/dev/null 2>&1 || need+=("$p"); done
  if [ ${#need[@]} -gt 0 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${need[@]}" >/dev/null
    echo "[ ok ] نصب شد: ${need[*]}"
  else
    echo "[ ok ] همهٔ بسته‌های سیستم نصب است"
  fi
  # a rename, not an overwrite: this running copy keeps reading its own file
  install -m 755 "$APP_DIR/deploy/vps/epc" /usr/local/bin/epc.new
  sed -i "s#^APP_DIR=.*#APP_DIR=$APP_DIR#" /usr/local/bin/epc.new
  mv /usr/local/bin/epc.new /usr/local/bin/epc
}
update() {
  local branch
  branch=$(runuser -u epc -- git -C "$APP_DIR" symbolic-ref --quiet --short HEAD) || {
    echo "[ !! ] شاخه Git مشخص نیست (detached HEAD)؛ به‌روزرسانی انجام نشد." >&2
    return 1
  }
  # Always fetch from the expected canonical URL, not a stale URL with a
  # username/password embedded in the checkout's origin configuration.
  if ! git_epc fetch --depth 1 "$REPO_URL" "$branch"; then
    echo "[ !! ] دریافت کد از GitHub شکست خورد. Build و Migration اجرا نشدند." >&2
    echo "       توکن Contents:read مخزن را با sudo epc save-token ثبت/تمدید کنید." >&2
    return 1
  fi
  if ! runuser -u epc -- git -C "$APP_DIR" reset --hard FETCH_HEAD; then
    echo "[ !! ] اعمال نسخه دریافت‌شده شکست خورد؛ Build و Migration اجرا نشدند." >&2
    return 1
  fi
  deps || return 1
  build || return 1
  run npm run db:migrate || return 1
}
backup() { run npm run db:backup -- --keep "${KEEP:-14}"; }

cmd="${1:-help}"; shift || true
case "$cmd" in
  status)  systemctl --no-pager status epc caddy | sed -n '1,4p;/Active/p'
           grep '^APP_URL=' "$ENV_FILE" | sed 's/^APP_URL=/   /' ;;
  logs)    journalctl -u epc -f -n 100 ;;
  restart) systemctl restart epc; wait_up && echo "[ ok ] بالا است" ;;
  admin)   [ -n "${1:-}" ] || { echo "epc admin <email> ['نام']" >&2; exit 1; }
           offline run npm run auth:admin -- "$1" "" "${2:-}" ;;
  demo)    [ -n "${1:-}" ] || { echo "epc demo <email-of-an-admin>" >&2; exit 1; }
           offline run npm run demo:seed -- "$1" ;;
  backup)  offline backup ;;
  backups) run npm run db:backup -- list ;;
  update)  offline update ;;
  deps)    deps ;;
  doctor)  offline run npm run doctor ;;
  run)     [ -n "${1:-}" ] || { echo "epc run <npm-script> [args…]   e.g. epc run furnace:load you@example.com" >&2; exit 1; }
           s="$1"; shift; offline run npm run "$s" -- "$@" ;;
  save-token)
           read -rsp "GitHub token (Contents: read): " t; echo >&2
           [ -n "$t" ] || { echo "[ !! ] توکن خالی است." >&2; exit 1; }
           umask 077; printf '%s' "$t" > "$TOKEN_FILE"; chmod 600 "$TOKEN_FILE"
           echo "[ ok ] ذخیره شد در $TOKEN_FILE (فقط root)" ;;
  _run)    run "$@" ;;
  _build)  build ;;
  _wait)   wait_up ;;
  *) cat >&2 <<'HELP'
epc status                  وضعیت سرویس و نشانی
epc logs                    گزارش زندهٔ برنامه (Ctrl+C برای خروج)
epc restart                 راه‌اندازی دوباره
epc admin <email> ['نام']    ساخت حساب مدیر و پروژهٔ DEMO؛ رمز یک‌بار چاپ می‌شود
epc demo <email>            پر کردن پروژهٔ DEMO آن مدیر با دادهٔ نمونه
epc backup                  پشتیبان وارسی‌شده (هر شب ۰۲:۴۰ خودکار هم گرفته می‌شود)
epc backups                 فهرست پشتیبان‌ها
epc update                  دریافت آخرین نسخه از GitHub، build و migration
epc deps                    نصب بسته‌های سیستمِ تازه (tesseract، OpenCV…) — update خودش اجرا می‌کند
epc save-token              ذخیرهٔ توکن GitHub تا update دوباره نپرسد
epc doctor                  بررسی پیکربندی
epc run <script> [args]     اجرای یک اسکریپت بارگذاری (مثلاً furnace:load you@example.com)
HELP
  ;;
esac
