{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/v1beta/:path(.*)", "destination": "/api/relay?path=:path" },
    { "source": "/v1/:path(.*)", "destination": "/api/anthropic?path=:path" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "cache-control", "value": "no-store" }] }
  ]
}
