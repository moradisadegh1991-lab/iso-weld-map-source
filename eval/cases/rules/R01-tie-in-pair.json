{
  "id": "R01-tie-in-pair",
  "title": "Tie-in -> 1 weld, always Field",
  "rule": "Tie-in → ۱ جوش، همیشه Field",
  "options": { "spoolMaxLen": 30000, "maxPipeLength": 30000 },
  "input": {
    "meta": { "nps": 12, "schedule": "SCH 40", "pupLength": 0 },
    "nodes": [
      { "id": "N1", "type": "tie-in", "ref": "TP-A", "E": 0, "N": 0, "EL": 10000 },
      { "id": "N2", "type": "tie-in", "ref": "TP-B", "E": 0, "N": 4000, "EL": 10000 }
    ],
    "edges": [{ "from": "N1", "to": "N2", "nps": 12 }]
  },
  "expect": {
    "weldCount": 2,
    "fieldWelds": ["W-01", "W-02"],
    "spoolCount": 1,
    "girthWelds": 0,
    "register": [
      { "no": "W-01", "loc": "Field", "kind": "Tie-in", "nps": 12, "role": "TP-A" },
      { "no": "W-02", "loc": "Field", "kind": "Tie-in", "nps": 12, "role": "TP-B" }
    ]
  }
}
