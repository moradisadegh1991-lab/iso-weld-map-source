        "type": "tie-in",
        "ref": "A",
        "E": 0,
        "N": 0,
        "EL": 10000
      },
      {
        "id": "N2",
        "type": "tee",
        "ref": "",
        "E": 0,
        "N": 4000,
        "EL": 10000
      },
      {
        "id": "N3",
        "type": "tie-in",
        "ref": "B",
        "E": 3000,
        "N": 7000,
        "EL": 10000
      },
      {
        "id": "N4",
        "type": "tie-in",
        "ref": "C",
        "E": -3000,
        "N": 7000,
        "EL": 10000
      }
    ],
    "edges": [
      {
        "from": "N1",
        "to": "N2",
        "nps": 12
      },
      {
        "from": "N2",
        "to": "N3",
        "nps": 12
      },
      {
        "from": "N2",
        "to": "N4",
        "nps": 12
      }
