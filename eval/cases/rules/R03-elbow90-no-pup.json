      { "id": "N3", "type": "tie-in", "ref": "TP-B", "E": 0, "N": 4000, "EL": 14000 }
    ],
    "edges": [
      { "from": "N1", "to": "N2", "nps": 12 },
      { "from": "N2", "to": "N3", "nps": 12 }
    ]
  },
  "expect": { "weldCount": 4, "fieldWeldCount": 2, "spoolCount": 1, "girthWelds": 0 }
