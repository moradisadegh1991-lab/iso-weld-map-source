# ── authentication ───────────────────────────────────────────────────────
# The address people open, for the one-time links printed by
# `npm run auth:developer` (the users page builds its own from the browser).
# APP_URL=https://epc.example.ir
# dev trusts the bearer token as the user id. Laptop only: with this set,
# anyone who can reach the server is whoever they say they are.
AUTH_MODE=dev
# "Forgot my password" by mail: with all of these set (and APP_URL above), the
# sign-in form mails a one-time link to the address on the account. Without
# them it files a request for the administrators, who hand the link over.
# SMTP_HOST=mail.example.ir
# SMTP_PORT=587          # 465 = TLS from the start (SMTP_SECURE=on)
# SMTP_USER=epc@example.ir
# SMTP_PASS=...
# SMTP_FROM="EPC Platform <epc@example.ir>"

# ── model provider ───────────────────────────────────────────────────────
# anthropic (default) | openai-compatible | gemini — the default only: the model
# picker offers every provider's models and the picked model decides who answers.
LLM_PROVIDER=anthropic
# Which are offered (default: anthropic,gemini, plus openai-compatible when LLM_BASE_URL is set).
# LLM_PROVIDERS=anthropic,gemini

# -- anthropic --
# From a server Anthropic does not serve (Iran), through the Vercel relay
# (deploy/gemini-relay): its token replaces the key, which stays on Vercel.
# ANTHROPIC_BASE_URL=https://<relay>.vercel.app/v1
# ANTHROPIC_RELAY_TOKEN=...
# Server-side only. A key in the request body is a key in the browser, in
# every proxy log on the way, and in anyone's devtools.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_REPAIR_MODEL=claude-opus-5

# -- openai-compatible: vLLM, SGLang, anything speaking /v1/chat/completions --
# LLM_BASE_URL=http://vllm:8000/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=Qwen/Qwen2.5-VL-32B-Instruct
# LLM_REPAIR_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# What the cluster actually serves, as id|label|note entries:
# LLM_MODELS=Qwen/Qwen2.5-VL-32B-Instruct|Qwen2.5-VL 32B|پیش‌فرض,Qwen/Qwen3-32B|Qwen3 32B|متنی
# Guided JSON decoding. Turn off only if the server does not implement it.
# LLM_JSON_MODE=on

# -- gemini: the Gemini API (Google AI Studio key) --
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_REPAIR_MODEL=gemini-4-argon
# The models a person picks from, as id|label|note entries (default: Google's current list):
# GEMINI_MODELS=gemini-3.8-flash|Gemini 3.8 Flash|پیش‌فرض,gemini-4-argon|Gemini 4 Argon|دقیق
# Through the relay on Vercel (deploy/gemini-relay), for a server Google does not
# serve ("User location is not supported"). The Gemini key then lives on Vercel;
# this server holds only the relay's token:
# GEMINI_BASE_URL=https://epc-gemini-relay.vercel.app/v1beta
# GEMINI_RELAY_TOKEN=...

# -- model usage accounting (lib/llm/accounting.mjs) --
# Every model call is recorded per project (tokens, model, who). Optional:
# prices per million tokens, model|input|output — no price is built in:
# LLM_PRICES=gemini-3.8-flash|0.30|2.50,gemini-4-argon|2|12
# LLM_PRICE_CURRENCY=USD
# a project's monthly allowance (input + output tokens, UTC month):
# LLM_MONTHLY_TOKENS=5000000

# ── database ─────────────────────────────────────────────────────────────
# Leave DATABASE_URL unset to run PGlite: real PostgreSQL, in-process.
# DATABASE_URL=postgres://user:pass@host:5432/isoweld
PGLITE_DIR=.pglite

# ── files: drawings, documents, site photos ──────────────────────────────
# local (default): a directory on this server — one server only.
STORAGE_DRIVER=local
STORAGE_ROOT=.storage
# s3: MinIO (or any S3). Needed for more than one app server, and for direct
# upload of drawings over 3.4 MB. See docs/RUNBOOK.md, step 5.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=https://files.example.ir   # what browsers reach; default S3_ENDPOINT
# S3_BUCKET=epc-files
# S3_ACCESS_KEY_ID=epc-app                      # the app user: read/write, no delete
# S3_SECRET_ACCESS_KEY=...

# Run migrations as a deploy step instead of lazily, for multi-instance deploys.
# DB_AUTO_MIGRATE=off
